[Unit]
Description=VoHost Dashboard (Minecraft panel on :8080)
After=network.target
[Service]
Type=simple
User=root
Environment=VOHOST_BASE=/opt/vohost
WorkingDirectory=/opt/vohost/backend
ExecStart=/opt/vohost/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
